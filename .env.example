# ---------------------------------------------------------------------------
# Commercial Property Investor Platform — environment configuration
#
# Copy to `.env.local` for development, or set these in your host's dashboard.
# Nothing here is required to run the app locally; every value has a sensible
# default. Anything NEXT_PUBLIC_* is exposed to the browser — never put a
# secret behind that prefix.
# ---------------------------------------------------------------------------

# --- Site identity (public) -------------------------------------------------
# Used for canonical URLs, sitemap.xml, robots.txt and links inside emails.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com.au
NEXT_PUBLIC_SITE_NAME=Commercial Investor Access
NEXT_PUBLIC_SITE_SHORT_NAME=Investor Access
NEXT_PUBLIC_CONTACT_EMAIL=invest@yourdomain.com.au
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LEGAL_NAME=Your Company Pty Ltd
NEXT_PUBLIC_ABN=

# --- Database ---------------------------------------------------------------
# SQLite file path. Must be on a PERSISTENT disk — on ephemeral hosts
# (Vercel, Netlify, Cloud Run) point this at a mounted volume or migrate to
# Postgres (see README → "Moving to Postgres").
DATABASE_PATH=./data/platform.db

# --- Admin sessions ---------------------------------------------------------
ADMIN_SESSION_TTL_HOURS=12

# --- Analytics (public) -----------------------------------------------------
# Set only the ones you use. Each tag loads only when its ID is present.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console: paste the token from the HTML-tag verification method,
# or verify by DNS and leave this blank.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Email delivery ---------------------------------------------------------
# Follow-up email is queued in the database and drained by `npm run email:dispatch`.
# Leave EMAIL_PROVIDER unset to print messages instead of sending them.
# One of: resend | postmark | smtp2go | webhook | log
EMAIL_PROVIDER=
EMAIL_FROM="Commercial Investor Access <no-reply@yourdomain.com.au>"

RESEND_API_KEY=
POSTMARK_TOKEN=
POSTMARK_STREAM=outbound
SMTP2GO_API_KEY=
EMAIL_WEBHOOK_URL=

# --- CRM / automation -------------------------------------------------------
# Every destination is optional and activates when its variable is set.
# Leads are always written to your own database first, so an outage here
# never loses a registration.

# Generic JSON POST — works with Zapier, Make, n8n, or your own endpoint.
LEAD_WEBHOOK_URL=
# Optional: signs the request body as X-Signature (HMAC-SHA256, hex).
LEAD_WEBHOOK_SECRET=

HUBSPOT_ACCESS_TOKEN=
# Google Apps Script web-app URL that appends a row to a sheet.
GOOGLE_SHEETS_WEBHOOK=
# Internal notification when a HOT lead registers.
SLACK_WEBHOOK_URL=

# --- Seed data (development only) -------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com.au
SEED_ADMIN_PASSWORD=ChangeMe-Immediately-2026
